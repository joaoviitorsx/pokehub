{
  "name": "pokehub-spike",
  "private": true,
  "version": "1.1.4",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "desktopName": "pokehub.desktop",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview:ui": "vite --host 127.0.0.1 --port 5174",
    "build": "node spike/clean-build.cjs && tsc --noEmit && vite build && tsc -p tsconfig.electron.json && node spike/finish-build.cjs",
    "test": "vitest run --testTimeout=20000 && node --test spike/tests/clean-build.node.cjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write",
    "dist:linux": "bun run build && electron-builder --linux AppImage --publish never",
    "dist:win": "bun run build && electron-builder --win nsis --publish never",
    "release:win": "bun run build && electron-builder --win nsis --publish always",
    "test:electron": "node scripts/run-electron-smoke.cjs",
    "test:packaged": "node scripts/run-packaged-smoke.cjs",
    "benchmark": "node scripts/benchmark-sessions.cjs",
    "release:linux": "bun run build && electron-builder --linux AppImage --publish always",
    "check:fuses": "node scripts/check-fuses.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/web-push": "^3.6.4",
    "electron": "44.10.2",
    "electron-builder": "26.15.3",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "overrides": {
    "fast-uri": "3.1.9",
    "undici@^6.0.0": "6.29.1",
    "undici@^7.0.0": "7.30.2"
  },
  "packageManager": "bun@1.4.4",
  "description": "Workspace local para sessões do PokéIdle.",
  "author": "joaoviitorsx",
  "build": {
    "appId": "local.pokehub.desktop",
    "productName": "PokeHub",
    "publish": [
      {
        "provider": "github",
        "owner": "joaoviitorsx",
        "repo": "pokehub",
        "releaseType": "draft"
      }
    ],
    "npmRebuild": false,
    "files": [
      "dist/**",
      "dist-remote/**",
      "dist-electron/**",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "syncDesktopName": true,
      "executableName": "pokehub",
      "icon": "build/icon.png",
      "desktop": {
        "entry": {
          "Name": "PokéHub",
          "Comment": "Workspace local para sessões do PokéIdle",
          "StartupWMClass": "PokeHub"
        }
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PokeHub",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
